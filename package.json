{
  "name": "registro-electricidad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude tests/rules.test.ts",
    "test:rules": "node scripts/emulators.mjs rules",
    "emulators": "node scripts/emulators.mjs start",
    "seed:demo": "node scripts/seed-emulators.mjs",
    "provision": "node scripts/provision.mjs",
    "deploy": "node scripts/check-deploy.mjs && npm run build && npx -y firebase-tools@latest deploy --only auth,firestore,hosting",
    "test:auth": "node scripts/emulators.mjs auth",
    "format": "prettier --write src scripts tests *.json *.ts *.md index.html",
    "access": "node scripts/username-access.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "firebase": "^12.18.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
